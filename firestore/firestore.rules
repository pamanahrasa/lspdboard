rules_version = '2';

// Paste this entire file into Firebase Console -> Firestore Database -> Rules -> Publish.
// See README.md "Setup" section for the full step-by-step.
//
// Model: anyone can READ (the Public Dashboard has no login), but only a
// signed-in Command Staff account can WRITE (add/edit/delete leave records
// or change settings). There is no public sign-up in this app, so the only
// way to be "signed in" is the one admin account you create yourself in
// Firebase Console -> Authentication -> Users.
service cloud.firestore {
  match /databases/{database}/documents {

    match /leaveRecords/{recordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
